# Set these as private environment variables in your Node hosting dashboard.
# Do not commit real credentials or expose provider keys in index.html.
APP_PASSWORD=replace-with-a-unique-password-at-least-16-characters
VAPI_PRIVATE_KEY=your-vapi-private-api-key
VAPI_ASSISTANT_ID=your-vapi-assistant-id
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
NODE_ENV=production
PORT=3000
